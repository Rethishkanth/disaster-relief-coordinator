<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Disaster Relief Resource Coordinator</display-name>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.LoginServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DisasterServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.DisasterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DisasterServlet</servlet-name>
        <url-pattern>/disasters</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShelterServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.ShelterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShelterServlet</servlet-name>
        <url-pattern>/shelters</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResourceServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.ResourceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResourceServlet</servlet-name>
        <url-pattern>/resources</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RequestServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.RequestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RequestServlet</servlet-name>
        <url-pattern>/requests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AllocationServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.AllocationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllocationServlet</servlet-name>
        <url-pattern>/allocations</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VolunteerServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.VolunteerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VolunteerServlet</servlet-name>
        <url-pattern>/volunteers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VehicleServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.VehicleServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehicleServlet</servlet-name>
        <url-pattern>/vehicles</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeliveryServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.DeliveryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeliveryServlet</servlet-name>
        <url-pattern>/delivery</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeliveryServlet</servlet-name>
        <url-pattern>/delivery-tracker</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/reports</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BackupServlet</servlet-name>
        <servlet-class>com.disasterrelief.servlet.BackupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BackupServlet</servlet-name>
        <url-pattern>/backups</url-pattern>
    </servlet-mapping>

    <!-- Session Config -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>
</web-app>
